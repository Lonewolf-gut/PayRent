{
  "buildCommand": "prisma generate && next build",
  "framework": "nextjs",
  "regions": ["iad1"],
  "env": {
    "AUTH_TRUST_HOST": "true"
  },
  "crons": [
    {
      "path": "/api/cron/repayments",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/repayment-reminders",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/subscriptions",
      "schedule": "0 0 * * *"
    }
  ]
}
