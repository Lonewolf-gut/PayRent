# =============================================================================
# PayRent Frontend — environment variables
# Copy to payrent-frontend/.env
# =============================================================================

NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Backend API (used for Next.js rewrites and server-side API calls)
API_URL="http://localhost:3001"

# Optional: set for client-side direct API calls in production
# NEXT_PUBLIC_API_URL="https://api.yourdomain.com"

# --- Auth (browser session cookies for NextAuth on the frontend) ---
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
