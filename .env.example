# =============================================================================
# PayRent Monorepo — environment setup
# =============================================================================
#
# Copy the example files into each app:
#   cp payrent-backend/.env.example payrent-backend/.env
#   cp payrent-frontend/.env.example payrent-frontend/.env
#
# Use the SAME AUTH_SECRET in both files.
# Put all database, payment, and integration keys in payrent-backend/.env.
#
# See payrent-backend/.env.example for the full list of backend variables.
# See payrent-frontend/.env.example for frontend-specific variables.
