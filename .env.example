# =============================================================================
# PayRent Frontend — environment variables
# Copy to payrent-frontend/.env
# =============================================================================

NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Backend API (required for NextAuth login on the server + Next.js rewrites)
# Variable name must be API_URL exactly (Next.js does not read "api-url" or similar).
API_URL="http://localhost:3001"
# Optional alias also supported: BACKEND_URL="http://localhost:3001"

# Optional: set in production when frontend and backend are on different domains
# NEXT_PUBLIC_API_URL="https://api.yourdomain.com"

# --- Auth (browser session cookies for NextAuth on the frontend) ---
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
