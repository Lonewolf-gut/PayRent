# =============================================================================
# PayRent Backend — environment variables
# Copy to payrent-backend/.env
# =============================================================================

NODE_ENV="development"
PORT="3001"
FRONTEND_URL="http://localhost:3000"

# --- Database ---
DATABASE_URL="postgresql://rentvest:rentvest@localhost:5432/rentvest?schema=public&connect_timeout=10&pool_timeout=10&connection_limit=10"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- Auth ---
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3001"

# --- JWT (mobile / API clients) ---
JWT_ACCESS_SECRET="replace-with-min-32-char-secret"
JWT_REFRESH_SECRET="replace-with-min-32-char-secret"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# --- Encryption ---
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# --- Cron ---
CRON_SECRET="replace-with-openssl-rand-base64-32"

# --- Email, SMS, Payments, Bank API ---
# See the root .env.example in the repository for the full list of integration keys.

SMTP_HOST="sandbox.smtp.mailtrap.io"
SMTP_PORT="2525"
SMTP_USER="your-mailtrap-user"
SMTP_PASSWORD="your-mailtrap-password"
SMTP_FROM="PayForMe <noreply@payforme.local>"

SMS_PROVIDER="log"
PAYMENT_PROVIDER="log"
PAYSTACK_SECRET_KEY="sk_test_your_key"
PAYSTACK_PUBLIC_KEY="pk_test_your_key"
BANK_API_KEY="replace-with-partner-bank-api-secret"

# --- EMTECH Beyond Sandbox (regulatory reporting) ---
# Get clientId/clientSecret from EMTECH App details after Integrate API.
EMTECH_ENABLED="false"
EMTECH_API_URL="https://api.emtech.com/integration"
EMTECH_CLIENT_ID=""
EMTECH_CLIENT_SECRET=""
EMTECH_DEVICE_ID="payforme-web"
EMTECH_TRANSACTION_CHANNEL="WEB"

SERVICE_FEE_PERCENT="1.5"
COMMISSION_FEE_PERCENT="2.0"
PROCESSING_FEE_PERCENT="0.5"
AGENT_COMMISSION_PERCENT="2.5"

RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="100"
